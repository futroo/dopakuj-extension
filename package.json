{
	"name": "dopakuj-extension",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"icons": "node scripts/generate-icons.mjs",
		"dev": "wxt",
		"dev:opera": "wxt -b opera",
		"preview:ui": "vite --config tests/preview/vite.config.ts --open /tests/preview/index.html",
		"postinstall": "wxt prepare",
		"build": "wxt build -b chrome && wxt build -b opera",
		"build:chrome": "wxt build -b chrome",
		"build:opera": "wxt build -b opera",
		"release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
		"release:linux": "bash scripts/build-release.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@lucide/vue": "^1.47.0",
		"@wxt-dev/module-vue": "^1.0.3",
		"vue": "^3.5.43",
		"wxt": "^0.21.4"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@types/chrome": "^0.1.32",
		"@vitejs/plugin-vue": "^6.0.1",
		"happy-dom": "^20.0.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vue-tsc": "^3.1.4"
	},
	"packageManager": "pnpm@10.14.0"
}
